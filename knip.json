{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/polyfills/*.js!", "scripts/check-contract-changes.mjs!"],
  "project": [
    "src/**/*.{js,jsx,ts,tsx,sass,scss}!",
    "ui/**/*.{ts,tsx,css}!",
    "scripts/**/*.{js,mjs}!"
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "exports",
    "types",
    "duplicates",
    "cycles"
  ],
  "ignoreBinaries": ["rustc", "cc"],
  "ignoreDependencies": ["lint-staged"],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"],
    "src/services/bindings.ts": ["types"],
    "ui/components/ui/**": ["exports", "types"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
